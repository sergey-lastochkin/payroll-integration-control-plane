    "approved": ["exporting"],
    "exporting": ["exported", "manual_check"],
    "exported": ["accepted", "rejected", "manual_check"],
    "accepted": ["paid", "rejected", "manual_check"],
    "paid": [],
    "rejected": [],
    "manual_check": []
  }
}
