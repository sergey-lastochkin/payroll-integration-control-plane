// Illustrative configuration-mapped orchestration module. ZUP performs payroll
// and NDFL calculation. This module validates the control boundary and never
// substitutes that engine; metadata must be mapped before runtime use.

Функция ПроверитьЦикл(Период, ТабельЗаполнен, КоличествоНеобработанныхДокументов) Экспорт
    Ошибки = Новый Массив;
    Если НЕ ЗначениеЗаполнено(Период) Тогда Ошибки.Добавить("PERIOD_REQUIRED"); КонецЕсли;
    Если НЕ ТабельЗаполнен Тогда Ошибки.Добавить("MISSING_TIMESHEET"); КонецЕсли;
    Если КоличествоНеобработанныхДокументов > 0 Тогда Ошибки.Добавить("PENDING_HR_DOCS"); КонецЕсли;
    Возврат Ошибки;
КонецФункции

Функция ПроверитьСтрокиВыплаты(СтрокиВыплаты) Экспорт
    Аномалии = Новый Массив;
    Сотрудники = Новый Соответствие;
    Счета = Новый Соответствие;
    Для Каждого СтрокаВыплаты Из СтрокиВыплаты Цикл
        Если Сотрудники.СодержитКлюч(СтрокаВыплаты.Сотрудник) Тогда
            Аномалии.Добавить("DUPLICATE_EMPLOYEE");
        Иначе
            Сотрудники.Вставить(СтрокаВыплаты.Сотрудник, Истина);
        КонецЕсли;
        Если НЕ ЗначениеЗаполнено(СтрокаВыплаты.БанковскийСчет) Тогда
            Аномалии.Добавить("MISSING_BANK_DETAILS");
        ИначеЕсли Счета.СодержитКлюч(СтрокаВыплаты.БанковскийСчет) Тогда
            Аномалии.Добавить("DUPLICATE_BANK_ACCOUNT");
        Иначе
            Счета.Вставить(СтрокаВыплаты.БанковскийСчет, СтрокаВыплаты.Сотрудник);
        КонецЕсли;
        Если СтрокаВыплаты.Сумма < 0 Тогда Аномалии.Добавить("NEGATIVE_PAYMENT"); КонецЕсли;
        Если СтрокаВыплаты.Сумма = 0 Тогда Аномалии.Добавить("UNEXPECTED_ZERO_SALARY"); КонецЕсли;
    КонецЦикла;
    Возврат Аномалии;
КонецФункции

Функция РазрешенПереходЦикла(СтароеСостояние, НовоеСостояние) Экспорт
    Переходы = Новый Соответствие;
    Переходы.Вставить("draft", "validation_failed,ready_for_review");
    Переходы.Вставить("validation_failed", "ready_for_review");
    Переходы.Вставить("ready_for_review", "approved,validation_failed");
    // "exporting" is a claim state. Target configuration must reserve the
    // batch with a compare-and-set before calling the external bank adapter.
    Переходы.Вставить("approved", "exporting");
    Переходы.Вставить("exporting", "exported,manual_check");
    Переходы.Вставить("exported", "accepted,rejected,manual_check");
    Переходы.Вставить("accepted", "paid,rejected,manual_check");
    Если СтароеСостояние = НовоеСостояние Тогда Возврат Истина; КонецЕсли;
    Если НЕ Переходы.СодержитКлюч(СтароеСостояние) Тогда Возврат Ложь; КонецЕсли;
    Возврат Найти("," + Переходы[СтароеСостояние] + ",", "," + НовоеСостояние + ",") > 0;
КонецФункции

Процедура УстановитьСостояниеЦикла(ЗаписьЦикла, НовоеСостояние, Источник, Основание = "") Экспорт
    Если НЕ РазрешенПереходЦикла(ЗаписьЦикла.Состояние, НовоеСостояние) Тогда
        ВызватьИсключение "ILLEGAL_PAYROLL_TRANSITION:" + ЗаписьЦикла.Состояние + "->" + НовоеСостояние;
    КонецЕсли;
    ЗаписьЦикла.Состояние = НовоеСостояние;
    ЗаписьЦикла.ИсточникИзменения = Источник;
    ЗаписьЦикла.ОснованиеИзменения = Основание;
    ЗаписьЦикла.ДатаИзменения = ТекущаяДата();
    ЗаписьЦикла.Записать();
КонецПроцедуры

Функция СформироватьПакетВыплат(ЗаписьЦикла, СтрокиВыплаты, ПодтвержденПользователем) Экспорт
    Если ЗаписьЦикла.Состояние <> "ready_for_review" Тогда
        ВызватьИсключение "PAYROLL_NOT_READY_FOR_REVIEW";
    КонецЕсли;
    Если НЕ ПодтвержденПользователем Тогда ВызватьИсключение "HUMAN_APPROVAL_REQUIRED"; КонецЕсли;
    Аномалии = ПроверитьСтрокиВыплаты(СтрокиВыплаты);
    Если Аномалии.Количество() > 0 Тогда
        ВызватьИсключение "PAYROLL_ANOMALIES:" + СтрСоединить(Аномалии, ",");
    КонецЕсли;
    УстановитьСостояниеЦикла(ЗаписьЦикла, "approved", "payroll-reviewer", "human approval");
    Пакет = Новый Структура;
    Пакет.Вставить("schema", "synthetic-payroll-batch.v1");
    Пакет.Вставить("period", Формат(ЗаписьЦикла.Период, "ДФ=yyyy-MM"));
    Пакет.Вставить("payments", СтрокиВыплаты);
    // Adapter writes a local synthetic payload in this reference implementation.
    УстановитьСостояниеЦикла(ЗаписьЦикла, "exported", "bank-adapter", "batch created");
    Возврат Пакет;
КонецФункции

Процедура ПринятьСтатусПакета(ЗаписьЦикла, ИдентификаторСобытия, СтатусБанка) Экспорт
    Если НЕ ЗначениеЗаполнено(ИдентификаторСобытия) Тогда ВызватьИсключение "CALLBACK_ID_REQUIRED"; КонецЕсли;
    // Target configuration persists callback IDs in a dedicated register.
    УстановитьСостояниеЦикла(ЗаписьЦикла, СтатусБанка, "bank-callback", ИдентификаторСобытия);
КонецПроцедуры
